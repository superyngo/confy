{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "confy",
  "identifier": "net.turkeyang.confy",
  "build": {
    "beforeBuildCommand": "bash \"$(git rev-parse --show-toplevel)/web/cf-build.sh\"",
    "beforeDevCommand": "npm --prefix \"$(git rev-parse --show-toplevel)/web\" run serve",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "confy",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: http: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
